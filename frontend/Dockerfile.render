# ==============================================================================
# Veriscore Frontend — Render Free Tier Dockerfile
# Uses a custom entrypoint to inject BACKEND_URL into a runtime JS config file.
# The frontend calls the backend directly (no nginx reverse proxy needed).
# ==============================================================================

# --- Stage 1: Build ---
FROM node:20-alpine AS builder

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

# --- Stage 2: Production ---
FROM nginx:1.27-alpine AS runner

RUN rm -rf /usr/share/nginx/html/*

COPY --from=builder /app/dist /usr/share/nginx/html

# Nginx config template (only needs $PORT substitution — no proxy)
COPY frontend/nginx.conf.template /etc/nginx/templates/default.conf.template

# Custom entrypoint: writes __runtime_config.js with BACKEND_URL before nginx starts
COPY frontend/docker-entrypoint-render.sh /docker-entrypoint-render.sh
RUN chmod +x /docker-entrypoint-render.sh

# Defaults (overridden by Render env vars at runtime)
ENV BACKEND_URL=http://localhost:5000
ENV PORT=80

# Only substitute PORT in the nginx template (not $uri, $host, etc.)
ENV NGINX_ENVSUBST_FILTER="^PORT$"

EXPOSE 80

ENTRYPOINT ["/docker-entrypoint-render.sh"]
